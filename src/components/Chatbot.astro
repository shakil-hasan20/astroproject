---
const { name } = Astro.props;
---

<div class="bot" id="bot">
  <div class="bot-tip" id="botTip" hidden>
    <span>Questions? Ask me anything 👋</span>
    <button type="button" id="botTipX" aria-label="Dismiss">×</button>
  </div>
  <button class="bot-fab" id="botFab" type="button" aria-label="Open chat assistant" aria-expanded="false" aria-controls="botPanel">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.2A8 8 0 1 1 21 12z"></path>
      <path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"></path>
    </svg>
    <i class="bot-unread" id="botUnread"></i>
  </button>
  <section class="bot-panel" id="botPanel" role="dialog" aria-label={`Chat with ${name}’s assistant`} aria-hidden="true">
    <header class="bot-head">
      <span class="bot-av">SM</span>
      <div class="bot-ttl">
        <b>{name.split(' ')[0]}’s Assistant</b>
        <small><i></i>Online · replies instantly</small>
      </div>
      <button type="button" id="botClose" aria-label="Close chat">×</button>
    </header>
    <div class="bot-msgs" id="botMsgs" aria-live="polite"></div>
    <div class="bot-chips" id="botChips"></div>
    <form class="bot-form" id="botForm" autocomplete="off">
      <input id="botInput" type="text" placeholder="Type your question…" aria-label="Your message" maxlength="300" enterkeyhint="send" />
      <button type="submit" aria-label="Send">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M3.4 20.4 21 12 3.4 3.6 3.3 10l12.6 2-12.6 2z"></path></svg>
      </button>
    </form>
  </section>
</div>
