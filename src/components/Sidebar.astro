---
import { img } from '../lib/sanity';
import type { Settings } from '../data/fallback';
interface Props { s: Settings }
const { s } = Astro.props;
const initials = s.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const wa = s.whatsapp?.replace(/\D/g, '');
const photo = img(s.avatarUrl, 400);
const logo = img(s.logoUrl, 200);
---

<aside class="card side">
  {logo && <img class="side-logo" src={logo} alt="" width="54" height="45" />}
  <div class="avatar">
    {photo ? <img src={photo} alt={s.name} width="160" height="160" /> : <span aria-hidden="true">{initials}</span>}
  </div>
  <div class="side-body">
    <h2 class="name">{s.name}{s.verified && <svg class="verified" viewBox="0 0 24 24" width="22" height="22" aria-label="Verified" role="img"><path fill="#146ef5" d="M12 1.6 14.6 4l3.5-.2.9 3.4 3 1.8-1.2 3.3 1.2 3.3-3 1.8-.9 3.4-3.5-.2L12 22.4 9.4 20l-3.5.2-.9-3.4-3-1.8 1.2-3.3-1.2-3.3 3-1.8.9-3.4L9.4 4z"/><path fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m8.2 12.2 2.7 2.7 5-5.4"/></svg>}</h2>
    <p class="role">{s.role}</p>
    {s.badge && <p class="badge"><i aria-hidden="true">★</i>{s.badge}</p>}
    <a class="btn" href="#contact">Let’s work together</a>
    <div class="icons">
      {s.email && (
        <a href={`mailto:${s.email}`} aria-label="Email">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        </a>
      )}
      {wa && (
        <a href={`https://wa.me/${wa}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
        </a>
      )}
    </div>
  </div>
</aside>
